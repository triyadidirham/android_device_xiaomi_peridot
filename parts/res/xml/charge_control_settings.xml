<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <Preference
        android:key="system_charge_control"
        android:title="@string/system_charge_control_title"
        android:summary="@string/system_charge_control_summary" />

    <ListPreference
        android:key="bypass_mode_pref"
        android:title="@string/bypass_mode_title"
        android:entries="@array/bypass_mode_entries"
        android:entryValues="@array/bypass_mode_values"
        android:persistent="false" />

    <androidx.preference.SwitchPreferenceCompat
        android:key="bypass_charging_pref"
        android:title="@string/bypass_charging_title"
        android:summary="@string/bypass_charging_summary_off"
        android:persistent="false" />
</PreferenceScreen>
